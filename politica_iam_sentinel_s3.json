{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsultarBucketDelProyecto",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::TU_BUCKET_AQUI"
    },
    {
      "Sid": "LeerYGuardarSoloSentinel",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::TU_BUCKET_AQUI/aguacate/sentinel2/*"
    }
  ]
}
